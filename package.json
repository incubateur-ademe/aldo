{
  "name": "aldo",
  "version": "1.0.0",
  "description": "Calculer le stock et les flux de carbone sur votre territoire",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "checkHTML": "site-validator --verbose --url",
    "checkHTMLLocal": "site-validator --verbose --local --url http://localhost:8080",
    "csvtojson": "sh csvtojson.sh",
    "dev": "node --watch server.ts",
    "start": "npm run csvtojson && node server.ts",
    "generate-flux1": "node scripts/generate-flux1-csv.ts",
    "generate-flux1-epci": "node scripts/generate-flux1-epci-csv.ts",
    "generate-flux2": "node scripts/generate-flux2-csv.ts",
    "generate-flux2-epci": "node scripts/generate-flux2-epci-csv.ts",
    "generate-flux3": "node scripts/generate-flux3-csv.ts",
    "generate-flux3-epci": "node scripts/generate-flux3-epci-csv.ts",
    "generate-stocks": "node scripts/generate-stocks-csv.ts",
    "generate-stocks-epci": "node scripts/generate-stocks-epci-csv.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incubateur-ademe/aldo"
  },
  "author": "helen.root@beta.gouv.fr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/incubateur-ademe/aldo/issues"
  },
  "homepage": "https://github.com/incubateur-ademe/aldo#readme",
  "dependencies": {
    "@etalab/decoupage-administratif": "^0.9.0-0",
    "@gouvfr/dsfr": "<1.5.0",
    "csvtojson": "^2.0.10",
    "dotenv": "^16.0.1",
    "ejs": "^3.1.7",
    "excel4node": "^1.8.0",
    "express": "^4.18.2",
    "googleapis": "^144.0.0",
    "sib-api-v3-sdk": "^8.4.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module"
}
