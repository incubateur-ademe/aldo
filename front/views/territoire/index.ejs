<%- include('../partials/header') -%>
<main role="main" id="contenu" tabindex="-1">
  <div class="fr-container fr-pb-6w fr-px-2w">
    <%- include('../partials/ariane', { items: [ { label: 'Accueil', url: '/' }, { label: singleLocation?.nom || 'Regroupement', }, ], }) -%>
    <%- include('./warnings') -%>
    <%- include('./introduction') -%>
    <form method="GET" class="fr-mt-4w" id="territory">
      <nav class="fr-nav territory-nav" role="navigation" aria-label="Navigation des sections du territoire">
        <ul class="fr-nav__list">
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= getTabUrl('stocks') %>" <%- tab === 'stocks' ? 'aria-current="page"' : '' %>>
              Stocks
            </a>
          </li>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= getTabUrl('flux') %>" <%- tab === 'flux' ? 'aria-current="page"' : '' %>>
              Flux
            </a>
          </li>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= getTabUrl('agricultural-practices') %>" <%- tab === 'agricultural-practices' ? 'aria-current="page"' : '' %>>
              Pratiques agricoles
            </a>
          </li>
          <% if (showCatenr) { %>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= getTabUrl('cat-enr') %>" <%- tab === 'cat-enr' ? 'aria-current="page"' : '' %>>
              Outil CAT'ENR
            </a>
          </li>
          <% } %>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= getTabUrl('configuration') %>" <%- tab === 'configuration' ? 'aria-current="page"' : '' %>>
              Configuration
            </a>
          </li>
        </ul>
      </nav>

      <div class="fr-mt-3w">
        <section class="territory-section" data-tab="stocks" <%= tab !== 'stocks' ? 'hidden' : '' %>>
          <%- include('./stocks') -%>
          <%- include('./modify-stocks-areas') -%>
        </section>
        <section class="territory-section" data-tab="flux" <%= tab !== 'flux' ? 'hidden' : '' %>>
          <%- include('./flux') -%>
          <%- include('./modify-flux-areas') -%>
          <%- include('./flux-grid') -%>
        </section>
        <section class="territory-section" data-tab="agricultural-practices" <%= tab !== 'agricultural-practices' ? 'hidden' : '' %>>
          <%- include('./agricultural-practices') -%>
        </section>
        <% if (showCatenr) { %>
        <section class="territory-section" data-tab="cat-enr" <%= tab !== 'cat-enr' ? 'hidden' : '' %>>
          <%- include('./catenr') -%>
        </section>
        <% } %>
        <section class="territory-section" data-tab="configuration" <%= tab !== 'configuration' ? 'hidden' : '' %>>
          <%- include('./shared-configuration') -%>
        </section>
      </div>
    </form>
  </div>
</main>
<script>
  // thanks to https://github.com/chhikaradi1993/Expandable-table-row
  const toggleRow = (element) => {
    if (element.nodeName === "BUTTON") {
      element = element.parentElement;
    }
    element.parentElement.getElementsByClassName('expanded-row-content')[0].classList.toggle('hide-row');
    event.stopPropagation();
  }

  // introduced to:
  // - shorten URLs by only including the values that are overridden
  // - handle the case for stocks where there are two inputs that can change the same value
  let queryParams = new URLSearchParams(window.location.search)

  // Les gestionnaires sont délégués au document : le contenu de <main> est remplacé
  // à chaque recalcul (voir `navigate`), les éléments d'origine disparaissent.
  function on(eventName, selector, handler) {
    document.addEventListener(eventName, (event) => {
      const element = event.target.closest(selector)
      if (element) handler(event, element)
    })
  }

  // les listes déroulantes de l'onglet CAT'ENR sont aussi portées par l'URL
  on('change', '#territory input, #territory select', (event) => {
    if (!event.target.name) return
    if (event.target.value === '') {
      queryParams.delete(event.target.name)
      return
    }
    queryParams.set(event.target.name, event.target.value)
  })

  // Recalcul sans rechargement : on demande la même page au serveur et on remplace
  // <main>. La position de défilement est conservée puisqu'il n'y a pas de navigation.
  // `target` : identifiant d'un élément vers lequel défiler une fois le contenu remplacé.
  async function navigate(url, { target, pushState = true } = {}) {
    const main = document.querySelector('main')
    main.setAttribute('aria-busy', 'true')
    const response = await fetch(url).catch(() => null)
    if (!response?.ok) {
      // erreur réseau ou page d'erreur : on laisse le navigateur l'afficher
      window.location.href = url
      return
    }
    const next = new DOMParser().parseFromString(await response.text(), 'text/html')
    // ponytail: les anciens graphiques restent enregistrés dans Chart.js si on ne les détruit pas
    main.querySelectorAll('canvas').forEach((canvas) => window.Chart?.getChart(canvas)?.destroy())
    main.replaceWith(next.querySelector('main'))
    // Les <script> insérés via DOMParser ne s'exécutent pas : on les recrée.
    // Les scripts externes (Chart.js) sont déjà chargés, on ne reprend que les scripts inline.
    document.querySelectorAll('main script:not([src])').forEach((script) => {
      script.replaceWith(Object.assign(document.createElement('script'), { textContent: script.textContent }))
    })
    if (pushState) window.history.pushState({}, '', url)
    queryParams = new URLSearchParams(window.location.search)
    if (target) {
      document.getElementById(target)?.scrollIntoView()
    }
    // le focus était sur un bouton qui n'existe plus : on le replace sur le contenu
    document.querySelector('main').focus({ preventScroll: true })
    window._paq?.push(['setCustomUrl', url])
    window._paq?.push(['trackPageView'])
  }

  function getTabUrl(tabName) {
    const pathParts = window.location.pathname.split('/')
    const locationType = pathParts[1]
    const locationCode = pathParts[2]
    if (locationType === 'regroupement') {
      return `/regroupement/${tabName}`
    }
    return `/${locationType}/${locationCode}/${tabName}`
  }

  function tabOf(link) {
    return link.getAttribute('href').split('?')[0].split('/').pop()
  }

  function currentTab() {
    const link = document.querySelector('.territory-nav .fr-nav__link[aria-current="page"]')
    return link ? tabOf(link) : 'stocks'
  }

  function switchTerritoryTab(tabName, shouldPushState = true) {
    document.querySelectorAll('.territory-section').forEach((section) => {
      section.hidden = section.dataset.tab !== tabName
    })
    document.querySelectorAll('.territory-nav .fr-nav__link').forEach((link) => {
      if (tabOf(link) === tabName) {
        link.setAttribute('aria-current', 'page')
      } else {
        link.removeAttribute('aria-current')
      }
    })
    if (shouldPushState) {
      const nextUrl = `${getTabUrl(tabName)}?${queryParams.toString()}`
      window.history.pushState({}, '', nextUrl)
    }
  }

  on('click', '.territory-nav .fr-nav__link', (event, link) => {
    event.preventDefault()
    switchTerritoryTab(tabOf(link))
  })

  on('click', 'button.to-stocks', () => switchTerritoryTab('stocks'))
  on('click', 'button.to-flux', () => switchTerritoryTab('flux'))
  on('click', 'button.to-config', () => switchTerritoryTab('configuration'))

  // handle URL here so that only relevant params are sent and we avoid URLs that get cut off
  // for being too long
  on('submit', 'form#territory', (event) => {
    event.preventDefault()
    const tab = currentTab()
    // l'outil CAT'ENR renvoie l'utilisateur sur ses résultats après un recalcul
    const target = tab === 'cat-enr' ? 'catenr-resultats' : undefined
    navigate(`${getTabUrl(tab)}?${queryParams.toString()}`, { target })
  })

  // Liens qui changent les paramètres de l'URL (réinitialisation, changement de
  // technologie CAT'ENR) : même traitement que la soumission.
  on('click', 'a.keep-scroll', (event, link) => {
    // les clics « ouvrir dans un nouvel onglet » restent gérés par le navigateur
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return
    event.preventDefault()
    navigate(link.getAttribute('href'))
  })

  // Retour arrière : simple changement d'onglet si seuls le chemin a changé,
  // nouveau calcul si les paramètres ont changé.
  window.addEventListener('popstate', () => {
    if (new URLSearchParams(window.location.search).toString() === queryParams.toString()) {
      const pathParts = window.location.pathname.split('/')
      switchTerritoryTab(pathParts[pathParts.length - 1] || 'stocks', false)
    } else {
      navigate(window.location.href, { pushState: false })
    }
  })
</script>
<%- include('../partials/footer') -%>
