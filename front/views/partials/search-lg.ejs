<div class="fr-container-fluid fr-my-6w">
  <form id="location-search-form" action="/regroupement" method="GET" class="fr-col-12 fr-col-md-8">
    <div role="search">
      <div id="default-search">
        <label class="fr-label fr-mb-1w" for="location-search">
          Choisir un ou plusieurs territoires
        </label>
        <ul id="locations" class="fr-tags-group">
        </ul>
        <div class="fr-grid-row">
          <input class="fr-input fr-col-12 fr-col-md-6" placeholder="Taper le nom, SIREN, ou code INSEE..." type="search" id="location-search" list="location-names" autocomplete="off">
          <button id="add-tag" class="fr-btn fr-btn--secondary fr-mx-1w fr-mt-1w fr-mt-md-0" title="Ajouter">
            Ajouter
          </button>
          <button class="fr-btn fr-mt-1w fr-mt-md-0" title="Rechercher">
            Rechercher
          </button>
        </div>
        <p id="location-search-error" class="fr-error-text" style="display: none;">
          Il faut choisir au moins un territoire depuis les options données
        </p>
      </div>
      <datalist id="location-names"></datalist>
    </div>
    <p class="fr-text--xs fr-my-1w">
      <a href="https://aldo-documentation.territoiresentransitions.fr/aldo-documentation/complements/perimetre-et-limites#maillage-administratif" target="_blank" rel="noopener">
        Nous utilisons les noms des EPCI et des communes de la fin de 2018
      </a>
    </p>
  </form>
</div>
<script>
  const COMMUNE_INSEE_CODE_LENGTH = 5
  const EPCI_SIREN_LENGTH = 9
  // Chromium becomes unresponsive for tens of seconds when an <input list="…">
  // is focused/typed into while its <datalist> holds tens of thousands of
  // <option>s (we have ~36 000 communes + EPCI combined). Keeping the datalist
  // capped well under that keeps native autocomplete responsive.
  const MAX_SUGGESTIONS = 50

  let locations = {}
  const searchForm = document.getElementById('location-search-form')
  const searchInput = document.getElementById('location-search')
  const locationNames = document.getElementById('location-names')
  const locationTags = document.getElementById('locations')

  fetch('/static/data/communes_17122018.csv.json').then(r => r.json()).then((data) => {
    data.forEach(loc => {
      locations[loc.insee] = loc.nom
    })
  })
  fetch('/static/data/epci.csv.json').then(r => r.json()).then((data) => {
    data.forEach(loc => {
      locations[loc.code] = loc.nom
    })
  })

  function updateSuggestions(query) {
    locationNames.innerHTML = ''
    if (!query) return
    const lowerQuery = query.toLowerCase()
    const fragment = document.createDocumentFragment()
    let count = 0
    for (const code in locations) {
      if (count >= MAX_SUGGESTIONS) break
      const name = locations[code]
      if (name.toLowerCase().includes(lowerQuery) || code.toLowerCase().includes(lowerQuery)) {
        const option = document.createElement('option')
        option.value = code + " "
        option.textContent = `${name} (${code})`
        fragment.appendChild(option)
        count++
      }
    }
    locationNames.appendChild(fragment)
  }

  searchInput.addEventListener('input', (event) => {
    updateSuggestions(event.target.value.trim())
  })

  function getLocationData(code) {
    if (!code) return
    const name = locations[code]
    if (name) {
      return {
        code,
        name
      }
    }
  }

  function codeToId(l) {
    return `loc-${l.code || l}`
  }

  function addLocationTag(location) {
    const id = codeToId(location)
    if (document.getElementById(id)) return

    const item = document.createElement('li')
    item.id = location.code
    const button = document.createElement('button')
    button.className = 'fr-tag fr-tag--dismiss'
    button.textContent = `${location.name} (${location.code})`
    button.value = location.code
    button.setAttribute('aria-label', `Retirer ${location.name}`)
    button.addEventListener('click', removeTag)
    item.appendChild(button)
    locationTags.appendChild(item)
    // add as hidden input for form submission and tracking
    const hidden = document.createElement('input')
    hidden.type = 'hidden'
    hidden.name = location.code.length === COMMUNE_INSEE_CODE_LENGTH ? 'communes[]' : 'epcis[]'
    hidden.value = location.code
    hidden.id = id
    searchForm.appendChild(hidden)
  }

  const onSearchValue = (event) => {
    let code = event.target.value
    // it isn't possible to add an event handler on option select so I've set the option values
    // to end in a space as a hacky workaround for detecting datalist selections
    const dataEntryCompleted = code.endsWith(" ")
    // this relies on all codes being convertible to truthy numbers
    code = code.trim()
    let isPotentialCode = code.length === COMMUNE_INSEE_CODE_LENGTH || code.length === EPCI_SIREN_LENGTH || ['1', '2', '3', '4'].includes(code)
    if (!dataEntryCompleted || !isPotentialCode) return
    handleInputChange(code)
  }
  searchInput.addEventListener('change', onSearchValue)
  searchInput.addEventListener('input', onSearchValue)

  // monitor pressing enter key
  searchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      const searchTerm = event.target.value
      if (searchTerm) {
        event.preventDefault()
        const locationData = handleInputChange(searchTerm)
        if (!locationData && searchTerm) {
          const relevantOptions = Object.entries(locations).filter(([code, lName]) => {
            const nameMatch = lName.toLowerCase().includes(searchTerm.toLowerCase())
            const codeMatch = code.toLowerCase().includes(searchTerm.toLowerCase())
            return nameMatch || codeMatch
          });
          if (relevantOptions.length === 1) {
            handleInputChange(relevantOptions.shift()[0])
          }
        }
      } else if (locationTags.children.length) {
        searchForm.requestSubmit()
      }
    }
  })

  document.getElementById('add-tag').addEventListener('click', (event) => {
    event.preventDefault()
    handleInputChange(searchInput.value)
  })

  function handleInputChange(value) {
    if (!value) return
    const code = value.trim()
    const locationData = getLocationData(code)
    if (locationData) {
      addLocationTag(locationData)
      searchInput.value = ""
      updateSuggestions('')
      return locationData
    }
  }

  function removeTag(event) {
    event.preventDefault()
    document.getElementById(codeToId(event.target.value))?.remove()
    event.target.parentNode.remove()
  }

  searchForm.addEventListener('submit', (event) => {
    if (locationTags.children.length === 0) {
      document.getElementById('default-search').classList.add('fr-input-group', 'fr-input-group--error')
      document.getElementById('location-search-error').style.display = ''
      event.preventDefault()
    }
  })
</script>