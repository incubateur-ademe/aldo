<%- include('page-setup') -%>
<div class="fr-skiplinks">
  <nav class="fr-container" role="navigation" aria-label="Accès rapide">
      <ul class="fr-skiplinks__list">
          <li>
              <a class="fr-nav__link" href="#contenu">Contenu</a>
          </li>
          <li>
              <a class="fr-nav__link" href="#header-navigation">Menu</a>
          </li>
          <li>
              <a class="fr-nav__link" href="#footer">Pied de page</a>
          </li>
      </ul>
  </nav>
</div>

<header role="banner" class="fr-header">
  <div class="fr-header__body">
    <div class="fr-container">
      <div class="fr-header__body-row">
        <div class="fr-header__brand fr-enlarge-link">
          <div class="fr-header__brand-top">
            <div class="fr-header__logo">
              <p class="fr-logo">
                République
                <br>Française
              </p>
            </div>
            <div class="fr-header__operator fr-responsive-img">
              <%- include('ademe-logo') -%>
            </div>
            <div class="fr-header__navbar">
              <button class="fr-btn--menu fr-btn" data-fr-opened="false" aria-controls="header-menu" aria-haspopup="menu" id="header-menu-btn" title="Menu">
                Menu
              </button>
            </div>
          </div>
          <div class="fr-header__service">
            <a href="/" title="Accueil - <%= appName %>">
              <img src="/static/images/logo_ALDO.png" class="aldo-logo" alt="ALDO : évaluez vos stocks et puits de carbone" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="fr-header__menu fr-modal" id="header-menu" aria-labelledby="header-menu-btn">
    <div class="fr-container">
      <button class="fr-btn--close fr-btn" aria-controls="header-menu" title="Fermer">Fermer</button>
      <div class="fr-header__menu-links"></div>
      <nav class="fr-nav" id="header-navigation" role="navigation" aria-label="Menu principal">
        <ul class="fr-nav__list">
          <% [['/', 'Accueil'], ['/fiches-actions', 'Fiches actions']].forEach(([href, label]) => { %>
            <li class="fr-nav__item">
              <a class="fr-nav__link" href="<%= href %>" target="_self"<% if (page === href) { %> aria-current="page"<% } %>><%= label %></a>
            </li>
          <% }) %>
        </ul>
      </nav>
    </div>
  </div>
</header>
<div class="aldo-banner">
  <p class="fr-container">L’outil des collectivités pour stocker du carbone dans les écosystèmes</p>
</div>
