<%- include('partials/header') -%>
<%
  const libelles = { type: 'Type de fiche', secteur: 'Secteur', objectif: 'Objectif', modalite: "Modalité d’action" }
  const slug = (texte) => texte.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
%>
<main role="main" id="contenu">
  <div class="fr-container fr-py-6w fr-px-2w">
    <h1>Fiches actions et leviers</h1>
    <p class="fr-text--lead">
      Des fiches à télécharger pour passer à l’action, classées par secteur, objectif et modalité d’action.
    </p>

    <form method="GET" action="/fiches-actions" class="fr-mb-4w">
      <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--bottom">
        <% for (const cle of Object.keys(libelles)) { %>
          <div class="fr-col-12 fr-col-md-6 fr-col-lg-3">
            <div class="fr-select-group fr-mb-0">
              <label class="fr-label" for="filtre-<%= cle %>"><%= libelles[cle] %></label>
              <select class="fr-select" id="filtre-<%= cle %>" name="<%= cle %>">
                <option value="">Tous</option>
                <% for (const option of options[cle]) { %>
                  <option value="<%= option %>" <%= filtres[cle] === option ? 'selected' : '' %>><%= option %></option>
                <% } %>
              </select>
            </div>
          </div>
        <% } %>
      </div>
      <ul class="fr-btns-group fr-btns-group--inline-md fr-mt-3w">
        <li><button type="submit" class="fr-btn">Filtrer</button></li>
        <li><a class="fr-btn fr-btn--secondary" href="/fiches-actions">Réinitialiser</a></li>
      </ul>
    </form>

    <p role="status"><strong><%= fiches.length %></strong> fiche<%= fiches.length > 1 ? 's' : '' %> sur <%= total %></p>

    <% if (fiches.length === 0) { %>
      <p>Aucune fiche ne correspond à ces critères.</p>
    <% } else { %>
      <ul class="fr-grid-row fr-grid-row--gutters" style="list-style: none; padding: 0">
        <% for (const fiche of fiches) { %>
          <li class="fr-col-12 fr-col-md-6 fr-col-lg-4">
            <div class="fr-card aldo-fiche aldo-fiche--<%= slug(fiche.secteur) %>">
              <div class="fr-card__body">
                <p class="fr-mb-2w">
                  <span class="fr-badge fr-badge--sm"><%= fiche.type %></span>
                  <span class="fr-badge fr-badge--sm fr-badge--green-emeraude"><%= fiche.secteur %></span>
                </p>
                <h2 class="fr-card__title fr-h6"><%= fiche.nom %></h2>
                <div class="fr-card__desc">
                  <% if (fiche.objectifs.length) { %>
                    <p class="fr-mb-1w"><strong>Objectif :</strong> <%= fiche.objectifs.join(' ; ') %></p>
                  <% } %>
                  <% if (fiche.modalite) { %>
                    <p class="fr-mb-1w"><strong>Modalité :</strong> <%= fiche.modalite %></p>
                  <% } %>
                  <% if (fiche.leviers.length) { %>
                    <ul class="fr-tags-group">
                      <% for (const levier of fiche.leviers) { %>
                        <li><p class="fr-tag fr-tag--sm"><%= levier %></p></li>
                      <% } %>
                    </ul>
                  <% } %>
                  <% if (fiche.fichier) { %>
                    <a class="fr-link fr-fi-download-line fr-link--icon-left" download href="/static/fiches-actions/<%= fiche.fichier %>">
                      Télécharger la fiche (PDF)
                    </a>
                  <% } else { %>
                    <p class="fr-text--sm fr-mb-0">Fiche PDF bientôt disponible</p>
                  <% } %>
                </div>
              </div>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>
  </div>
</main>
<%- include('partials/footer') -%>
